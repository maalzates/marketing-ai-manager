# Docker Compose variables — NOT the Laravel .env (that one lives in src/.env).
# Copy to .env.docker on the server and fill in real values:
#   cp .env.docker.example .env.docker
# Generate secrets with: openssl rand -base64 32

# Public domain served by nginx (used to pick the Let's Encrypt certificate)
APP_DOMAIN=marketing.example.com

# MySQL
MYSQL_DATABASE=marketing_ai_production
MYSQL_USER=marketing_ai
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too

# Grafana (only used when the `observability` profile is enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_as_well
