# TLS terminates at Cloudflare (SSL/TLS mode: Flexible), so this origin speaks plain HTTP
# and holds no certificate. Consequences worth knowing before changing anything here:
#
#   * There is no :443 listener and no certbot. Issuing a certificate here would be dead
#     weight — Cloudflare never presents it.
#   * The hop from Cloudflare to this box is unencrypted. That is what Flexible means, and
#     it is only acceptable because UFW allows :80 from Cloudflare's ranges alone. If that
#     restriction is ever lifted, anyone hitting the origin IP reads traffic in the clear.
#   * The visitor's real IP and scheme arrive in headers, not on the connection. Laravel is
#     configured to trust them (see bootstrap/app.php); nginx restores the client IP below
#     so access logs and rate limiting are not all Cloudflare.

# Cloudflare edge ranges, refreshed on the server by cloudflare-ranges-refresh.
include /etc/nginx/cloudflare/real-ip.conf;

# Cloudflare reports the visitor's scheme, which is https even though this hop is not.
map $http_x_forwarded_proto $forwarded_https {
    default off;
    https   on;
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN};

    # Cloudflare adds HSTS at the edge; adding it here too would be duplicated on every
    # response. The rest are ours to set because Cloudflare does not.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /var/www/html/public;
    index index.php index.html;

    # Matches post_max_size in php.ini and the 300 MB cap in StoreAssetRequest. A smaller
    # value here answers 413 before PHP ever sees the upload.
    client_max_body_size 320M;

    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # The visitor reached Cloudflare over HTTPS even though this hop is HTTP. Without
        # this, Laravel builds http:// URLs and the browser blocks them as mixed content.
        fastcgi_param HTTPS $forwarded_https;
        # A 300 MB upload has to reach Drive within this window, and the request does not
    # return until it has.
        fastcgi_read_timeout 600;
    }

    # Vite emits content-hashed filenames, so this is safe to cache forever.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}
